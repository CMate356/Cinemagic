@model List<Address>
@{
    ViewData["Title"] = "Adresele mele";
}

<h1 class="h3 mb-3" style="color:#d4af37;">Adresele mele</h1>

@if (!Model.Any())
{
    <p class="text-muted">Nu ai nicio adresă salvată.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark align-middle">
            <thead><tr><th>Adresă</th><th>Telefon</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @a.Street, @a.City
                            @if (a.IsDefault)
                            {
                                <span class="badge bg-warning text-dark ms-1">implicită</span>
                            }
                        </td>
                        <td>@a.Phone</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (!a.IsDefault)
                                {
                                    <form asp-action="SetDefault" asp-route-id="@a.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Implicită</button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post"
                                      onsubmit="return confirm('Ștergi această adresă?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Șterge</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Create" class="btn" style="background-color:#d4af37;color:#000;font-weight:600;">Adaugă adresă</a>