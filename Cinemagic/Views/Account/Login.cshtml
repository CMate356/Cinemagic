@model Cinemagic.Models.LoginViewModel

@{
    ViewData["Title"] = "Autentificare";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2 class="brand-title">Autentificare</h2>
        
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-gold">Adresă Email</label>
                <input asp-for="Email" class="form-control" placeholder="nume@exemplu.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-gold">Parolă</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Parola ta" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-gold w-100 py-2 mt-3">Intră în cont</button>
        </form>

        <div class="text-center mt-3">
            <p class="text-muted">Nu ai cont încă? <a asp-action="Register" class="text-gold text-decoration-none">Creează cont nou</a></p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}