<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinemagic</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinemagic.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-3 bg-card border-gold-custom px-4 py-3">
            <div class="container-fluid">
                <!-- Logo -->
                <a class="navbar-brand brand-title m-0 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-gold" style="font-size: 1.2rem;">+</span> CINEMAGIC
                </a>

                <!-- Choose Cinema Dropdown -->
                <div class="dropdown ms-3">
                    <button class="btn btn-sm btn-gold dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Choose cinema
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Cinemagic Bucharest</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Cinemagic Cluj</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Cinemagic Iasi</a></li>
                    </ul>
                </div>

                <button class="navbar-toggler border-gold" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbarContent" aria-controls="mainNavbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbarContent">
                    <!-- Search Movies Bar -->
                    <form class="d-flex mx-auto my-2 my-lg-0" style="width: 700px;" method="get" asp-controller="Films" asp-action="Index">
                        <input class="form-control form-control-sm bg-dark text-light border-secondary" type="search" name="search" placeholder="Search movies..." aria-label="Search" autocomplete="off">
                    </form>

                    <!-- Meniul principal & Autentificarea -->
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Films" asp-action="Index">Filme</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Products" asp-action="Category" asp-route-id="Snacks">Snacks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Products" asp-action="Category" asp-route-id="Merch">Merch</a>
                        </li>

                        <!-- Cart Button -->
                        <li class="nav-item">
                            <a class="btn btn-outline-gold btn-sm px-3" asp-controller="Cart" asp-action="Index">
                                Cart (0)
                            </a>
                        </li>

                        <!-- Secțiunea de Autentificare -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-gold">Salut, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline m-0">
                                    <button type="submit" class="btn btn-outline-gold btn-sm px-3">Deconectare</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-gold btn-sm px-3 text-dark fw-bold" asp-controller="Account" asp-action="Login">Account</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-auto bg-card border-secondary">
        <div class="container text-center text-muted">
            &copy; 2026 - Cinemagic - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-gold text-decoration-none">Confidențialitate</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>