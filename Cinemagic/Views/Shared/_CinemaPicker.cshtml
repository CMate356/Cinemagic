@model Cinemagic.ViewModels.CinemaSelectionViewModel

@* Shared by the home page and /Cinemas. The search form posts back to the page it is on. *@

<section class="cinema-hero">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="mb-2">Choose your cinema</h1>
            <p class="text-muted-custom mb-4">Pick a cinema to see its program and book tickets for the films.</p>

            <form method="get" action="@Context.Request.Path" class="cinema-search mx-auto" role="search">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <label for="q" class="visually-hidden">Search city or cinema</label>
                <input id="q" name="q" value="@Model.Query" class="form-control" placeholder="Search city or cinema" autocomplete="off" />
            </form>
        </div>

        @if (Model.Cinemas.Count == 0)
        {
            <div class="text-center text-muted-custom">
                <p>No cinemas match “@Model.Query”. Try another city or name.</p>
                <a href="@Context.Request.Path" class="btn btn-outline-gold">Show all cinemas</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
                @foreach (var cinema in Model.Cinemas)
                {
                    var isSelected = cinema.Id == Model.SelectedCinemaId;

                    <div class="col">
                        <div class="card cinema-card h-100 @(isSelected ? "is-selected" : "")">
                            <div class="card-body d-flex flex-column">
                                <span class="cinema-pin" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z" />
                                        <circle cx="12" cy="10" r="2.5" />
                                    </svg>
                                </span>
                                <h2 class="h5 mt-2 mb-1">@cinema.Name</h2>
                                <p class="text-muted-custom small mb-3">@cinema.Address, @cinema.City</p>

                                <form asp-controller="Cinemas" asp-action="Select" method="post" class="mt-auto">
                                    <input type="hidden" name="id" value="@cinema.Id" />
                                    <input type="hidden" name="returnUrl" value="@(Model.ReturnUrl ?? Context.Request.Path.Value)" />
                                    @if (isSelected)
                                    {
                                        <button type="submit" class="btn btn-outline-gold w-100">Selected cinema</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-gold w-100">Select cinema</button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <p class="text-center text-muted-custom small mt-5">Snacks and merch can be bought without choosing a cinema.</p>
    </div>
</section>
